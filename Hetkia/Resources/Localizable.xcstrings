    "story.cafe.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I found a seat by the window and watched the afternoon settle in. The coffee cooled slowly while the street kept its gentle rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontré un sitio junto a la ventana y vi cómo avanzaba la tarde. El café se enfrió poco a poco mientras la calle mantenía su ritmo tranquilo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันเลือกที่นั่งริมหน้าต่างและมองบ่ายค่อย ๆ ผ่านไป กาแฟค่อย ๆ เย็นลง ขณะที่ถนนยังคงมีจังหวะอันนุ่มนวล"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在窗边找了个位置，看着午后慢慢安静下来。咖啡渐渐凉了，街道仍保持着温柔的节奏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我在窗邊找了個位置，看著午後慢慢安靜下來。咖啡漸漸涼了，街道仍保持著溫柔的節奏。"
          }
        }
      }
    },
    "story.cafe.excerpt" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A warm cup and a little time to myself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una taza caliente y un rato para mí."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กาแฟอุ่นหนึ่งถ้วยกับเวลาส่วนตัวเล็กน้อย"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一杯温热的咖啡，一段属于自己的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一杯溫熱的咖啡，一段屬於自己的時間。"
          }
        }
      }
    },
    "story.cafe.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A slow afternoon at the café"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarde tranquila en la cafetería"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บ่ายสบาย ๆ ที่คาเฟ่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咖啡馆里的慢时光"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咖啡館裡的慢時光"
          }
        }
      }
    },
    "story.coast.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wind carried the sound of waves across the shore. I stayed a little longer, watching the water change color with the passing clouds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El viento llevó el sonido de las olas por la orilla. Me quedé un poco más, viendo cómo cambiaba el color del agua con las nubes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สายลมพาเสียงคลื่นมาตามชายฝั่ง ฉันอยู่ต่ออีกสักพัก มองผืนน้ำเปลี่ยนสีตามเมฆที่เคลื่อนผ่าน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "风把海浪的声音送到岸边。我多停留了一会儿，看云影经过时海水如何变换颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "風把海浪的聲音送到岸邊。我多停留了一會兒，看雲影經過時海水如何變換顏色。"
          }
        }
      }
    },
    "story.coast.excerpt" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wind, salt, and the long line where water meets sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viento, sal y la línea lejana entre el mar y el cielo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลม กลิ่นทะเล และเส้นขอบฟ้าที่บรรจบกับผืนน้ำ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海风、咸味，还有水天相接的远方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海風、鹹味，還有水天相接的遠方。"
          }
        }
      }
    },
    "story.coast.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sea held the afternoon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mar guardó la tarde"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทะเลเก็บบ่ายวันนั้นไว้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海把午后留住了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海把午後留住了"
          }
        }
      }
    },
    "story.flowers.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I took the longer way through the flower market. The stalls were closing, but the last sunlight still rested on the petals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di un rodeo por el mercado de flores. Los puestos estaban cerrando, pero la última luz del sol aún descansaba sobre los pétalos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันอ้อมไปทางตลาดดอกไม้ แผงค้ากำลังปิด แต่แสงสุดท้ายของวันยังแตะอยู่บนกลีบดอก"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我绕了远路经过花市。摊位准备收摊了，最后一缕阳光还停在花瓣上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我繞了遠路經過花市。攤位準備收攤了，最後一縷陽光還停在花瓣上。"
          }
        }
      }
    },
    "story.flowers.excerpt" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A few bright colors made the whole market feel lighter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos colores vivos hicieron más alegre todo el mercado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สีสันสดใสไม่กี่สีทำให้ทั้งตลาดดูสดชื่นขึ้น"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几抹明亮的颜色，让整个市场都轻快起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾抹明亮的色彩，讓整個市場都輕快起來。"
          }
        }
      }
    },
    "story.flowers.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowers on the way home"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flores de camino a casa"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดอกไม้ระหว่างทางกลับบ้าน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回家路上的花"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回家路上的花"
          }
        }
      }
    },
    "story.garden.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sat beside the path and listened to the garden. Nothing asked for my attention; the afternoon was enough as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me senté junto al sendero y escuché el jardín. Nada reclamaba mi atención; la tarde, tal como era, bastaba."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันนั่งข้างทางเดินและฟังเสียงในสวน ไม่มีอะไรเรียกร้องความสนใจ บ่ายวันนั้นเป็นแบบที่เป็นก็เพียงพอแล้ว"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我坐在小径旁听花园的声音。没有什么要求我去留意，午后就这样已经很好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我坐在小徑旁聽花園的聲音。沒有什麼要求我去留意，午後就這樣已經很好。"
          }
        }
      }
    },
    "story.garden.excerpt" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The leaves moved softly in the late summer air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las hojas se movían suavemente con el aire de finales de verano."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใบไม้ไหวเบา ๆ ในลมปลายฤดูร้อน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叶子在夏末的风里轻轻摇晃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "葉子在夏末的風裡輕輕搖晃。"
          }
        }
      }
    },
    "story.garden.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
