    "onthisday.empty.invitation" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave a few memories for your future self, whenever it feels right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando quieras, guarda algún recuerdo para tu yo del futuro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อพร้อม ค่อยเก็บความทรงจำเล็ก ๆ ไว้ให้ตัวเองในวันข้างหน้า"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从今天开始，为未来的自己留下一些回忆吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從今天開始，為未來的自己留下一些回憶吧。"
          }
        }
      }
    },
    "onthisday.empty.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shared meal, a friend's smile, or a view along the way can become a lovely memory. There is no need to capture it all; ordinary days can shine when you look back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comida compartida, la sonrisa de un amigo o un paisaje del camino pueden ser recuerdos entrañables. No hace falta guardarlo todo: al mirar atrás, también brillan los días sencillos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มื้ออาหารร่วมกัน รอยยิ้มของเพื่อน หรือวิวระหว่างทาง ล้วนเป็นความทรงจำที่น่ารัก ไม่ต้องบันทึกทุกอย่าง เพราะเมื่อมองย้อนกลับมา วันธรรมดาก็เปล่งประกายได้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活里有许多值得记住的小事：一顿饭、朋友的笑脸，或偶然遇见的风景。不必刻意记录，平凡日子也会在多年后闪着光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活裡有許多值得記住的小事：一頓飯、朋友的笑臉，或偶然遇見的風景。不必刻意記錄，平凡日子也會在多年後閃著光。"
          }
        }
      }
    },
