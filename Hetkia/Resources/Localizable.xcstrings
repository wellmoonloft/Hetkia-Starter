    },
    "story.walk.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing special was planned today. I took the familiar path at an unhurried pace. When I looked up, the light had just reached the treetops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no tenía ningún plan especial. Recorrí sin prisa el camino de siempre. Al levantar la vista, la luz acababa de llegar a las copas de los árboles."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ไม่มีแผนพิเศษ ฉันเดินไปตามเส้นทางคุ้นเคยอย่างไม่รีบร้อน พอเงยหน้าขึ้น แสงแดดก็เพิ่งส่องถึงยอดไม้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天没有特别的安排，只是沿着熟悉的路慢慢走。抬头时，光刚好落在树梢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天沒有特別的安排，只是沿著熟悉的路慢慢走。抬頭時，光正好落在樹梢。"
          }
        }
      }
    },
