    "onboarding.welcome.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia can prepare a daily journal from selected photos. You stay in control of what is included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia puede preparar un diario a partir de las fotos que elijas. Tú decides qué incluir."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia ช่วยเรียบเรียงบันทึกประจำวันจากรูปที่คุณเลือก โดยคุณเป็นผู้กำหนดทุกอย่าง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时光可以根据你选中的照片整理每日手札，哪些内容加入始终由你决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時光可以根據你選取的照片整理每日手札，哪些內容加入始終由你決定。"
          }
        }
      }
    },
    "onboarding.welcome.title" : {
