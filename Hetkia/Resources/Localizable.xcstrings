    "onthisday.tagline" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave today for yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedica el día de hoy a ti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บวันนี้ไว้เพื่อตัวคุณเอง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把今天，留给自己。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把今天，留給自己。"
          }
        }
      }
    },
    "page.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing special was planned today. I took the familiar path at an unhurried pace. When I looked up, the light had just reached the treetops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no tenía ningún plan especial. Recorrí sin prisa el camino de siempre. Al levantar la vista, la luz acababa de llegar a las copas de los árboles."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ไม่มีแผนพิเศษ ฉันเดินไปตามเส้นทางคุ้นเคยอย่างไม่รีบร้อน พอเงยหน้าขึ้น แสงแดดก็เพิ่งส่องถึงยอดไม้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天没有特别的安排，只是沿着熟悉的路慢慢走。抬头时，光刚好落在树梢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天沒有特別的安排，只是沿著熟悉的路慢慢走。抬頭時，光正好落在樹梢。"
          }
        }
      }
    },
    "page.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the ordinary days close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cerca los días sencillos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บวันธรรมดาไว้ใกล้ใจ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把平凡日子，收进时光里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把平凡日子，收藏在時光裡。"
          }
        }
      }
    },
    "page.heading" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even ordinary moments have their own light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta los momentos sencillos tienen su propia luz."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ช่วงเวลาธรรมดาก็มีแสงสว่างของตัวเอง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常的片刻，也有自己的光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常的片刻，也有自己的光。"
