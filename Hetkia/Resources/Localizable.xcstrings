          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พักสักครู่ในสวน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花园里的小小停顿"
