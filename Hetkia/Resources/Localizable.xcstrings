    "onboarding.photos.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Photos access lets Hetkia find this calendar date across your library. It reads metadata to display memories; it saves a diary and photo previews only when you generate or edit a diary or add a comment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso completo a Fotos permite encontrar esta fecha en toda tu biblioteca. Hetkia solo lee metadatos para mostrar recuerdos y guarda el diario y las vistas previas cuando lo generas, editas o añades un comentario."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงรูปภาพทั้งหมดช่วยให้ Hetkia ค้นหาวันเดียวกันจากคลังรูปภาพของคุณ แอปอ่านเฉพาะข้อมูลกำกับเพื่อแสดงความทรงจำ และจะบันทึกไดอารี่กับภาพตัวอย่างเมื่อคุณสร้างหรือแก้ไขไดอารี่ หรือเพิ่มความคิดเห็นเท่านั้น"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要完整照片权限，时光才能从整个图库查找历年同一天。浏览时只读取信息用于展示；只有生成或修改日记、添加评论时，才会保存日记和照片预览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要完整照片權限，時光才能從整個圖庫尋找歷年同一天。瀏覽時只讀取資訊供展示；只有生成或修改日記、添加留言時，才會儲存日記和照片預覽。"
          }
        }
      }
    },
    "onboarding.photos.detail.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia needs full Photos access to find this date across your library. You can grant access in Settings or close the app if you prefer not to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia necesita acceso completo a Fotos para buscar esta fecha en toda tu biblioteca. Puedes concederlo en Ajustes o cerrar la app si lo prefieres."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetkia ต้องใช้สิทธิ์เข้าถึงรูปภาพทั้งหมดเพื่อค้นหาวันนี้ในคลังของคุณ คุณอนุญาตได้ในการตั้งค่า หรือปิดแอปหากไม่ต้องการ"
