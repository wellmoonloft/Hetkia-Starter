    "settings.ai.prompt.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the instructions used when generating a diary from today’s photos. The default prompt asks for a grounded entry in your system language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las instrucciones para generar un diario a partir de las fotos del día. El texto predeterminado pide una entrada basada en pruebas y escrita en el idioma del sistema."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดคำสั่งสำหรับสร้างบันทึกจากรูปภาพของวันนี้ โดยค่าเริ่มต้นจะเขียนอย่างเป็นธรรมชาติในภาษาของระบบและอิงตามหลักฐาน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置根据当天照片生成日记时使用的指令。默认提示词会要求使用系统语言，并以照片证据为依据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定根據當日照片產生日記時使用的指令。預設提示詞會要求使用系統語言，並以照片證據為依據。"
          }
