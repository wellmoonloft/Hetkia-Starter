    "settings.map-coordinate.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapKit displays coordinates on the selected map. The system option converts only when your device region is China mainland. Saved photo coordinates remain WGS-84."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapKit muestra las coordenadas en el mapa seleccionado. La opción del sistema convierte solo si la región del dispositivo es China continental. Las coordenadas guardadas permanecen en WGS-84."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapKit จะแสดงพิกัดบนแผนที่ที่เลือก ตัวเลือกตามระบบจะแปลงพิกัดเฉพาะเมื่อภูมิภาคของอุปกรณ์เป็นจีนแผ่นดินใหญ่ พิกัดภาพถ่ายที่บันทึกไว้ยังคงเป็น WGS-84"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapKit 会在所选地图上显示坐标。跟随系统时，仅当设备地区为中国大陆才转换。保存的照片坐标始终保留为 WGS-84。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapKit 會在所選地圖上顯示座標。跟隨系統時，只有裝置地區為中國大陸才會轉換。已儲存的照片座標一律保留為 WGS-84。"
          }
        }
      }
    },
